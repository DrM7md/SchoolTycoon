/* Flex layout only, no absolute left/right offsets, so the root .rtl class can mirror it later. */
:root {
    --ink: rgb(36, 40, 46);
    --ink-soft: rgb(96, 104, 114);
    --paper: rgba(250, 248, 242, 0.94);
    --line: rgba(36, 40, 46, 0.12);
    --accent: rgb(46, 125, 96);
    --accent-ink: rgb(255, 255, 255);
    --danger: rgb(196, 64, 56);
    --good: rgb(46, 125, 96);
}

.hud { flex-grow: 1; justify-content: space-between; padding: 12px; }
.hud.rtl { flex-direction: column; }
.hud.rtl .top-bar, .hud.rtl .stats, .hud.rtl .time, .hud.rtl .facilities, .hud.rtl .card__actions { flex-direction: row-reverse; }

.bar {
    background-color: var(--paper);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line);
    padding: 8px 12px;
}

.top-bar { flex-direction: row; justify-content: space-between; align-items: center; }
.stats { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 1; }
.stat { color: var(--ink); font-size: 15px; margin: 0 14px 0 0; -unity-text-align: middle-left; }
.stat--primary { -unity-font-style: bold; font-size: 17px; }
.stat.negative { color: var(--danger); }
.stat--net.positive { color: var(--good); }
.stat--net.negative { color: var(--danger); }
.time { flex-direction: row; align-items: center; flex-shrink: 0; }
.speeds { flex-direction: row; margin-right: 10px; }

.button {
    color: var(--ink);
    background-color: rgb(236, 233, 224);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 7px;
    padding: 6px 12px;
    margin: 0 3px;
    font-size: 14px;
    min-width: 44px;
}
.button:hover { background-color: rgb(226, 222, 210); }
.button.is-active { background-color: var(--ink); color: rgb(255, 255, 255); }
.button--accent { background-color: var(--accent); color: var(--accent-ink); -unity-font-style: bold; }
.button--accent:hover { background-color: rgb(38, 108, 82); }
.button:disabled { opacity: 0.45; }

.center { flex-grow: 1; align-items: center; justify-content: center; }
.card {
    background-color: var(--paper);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--line);
    padding: 16px 20px;
    max-width: 520px;
}
.card__text { color: var(--ink); font-size: 16px; white-space: normal; margin-bottom: 12px; }
.card__actions { flex-direction: row; justify-content: flex-end; }
.incident { border-left-width: 5px; border-left-color: rgb(214, 150, 40); }
.outcome { font-size: 22px; -unity-font-style: bold; color: var(--ink); -unity-text-align: middle-center; }
.outcome.won { border-color: var(--good); border-width: 3px; }
.outcome.lost { border-color: var(--danger); border-width: 3px; }
.hidden { display: none; }

.toast {
    align-self: center;
    background-color: var(--danger);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 8px;
    font-size: 15px;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.18s, 0.18s;
    translate: 0 6px;
}
.toast.visible { opacity: 1; translate: 0 0; }

.build-bar { flex-direction: column; align-items: center; align-self: center; }
.build-hint { color: var(--ink-soft); font-size: 13px; margin-bottom: 6px; }
.facilities { flex-direction: row; }
.facility {
    flex-direction: column;
    align-items: center;
    min-width: 108px;
    padding: 8px 10px;
    border-bottom-width: 4px;
}
.facility__swatch { width: 18px; height: 18px; border-radius: 4px; margin-bottom: 4px; }
.facility__label { font-size: 13px; -unity-text-align: middle-center; white-space: nowrap; }
