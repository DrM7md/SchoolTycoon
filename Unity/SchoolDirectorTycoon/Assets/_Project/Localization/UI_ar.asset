  - m_Id: 517962905288824
    m_Localized: "\u0623\u0646\u0647\u0650 \u0627\u0644\u0645\u064A\u0632\u0627\u0646\u064A\u0629
      \u0623\u0648\u0644\u064B\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288825
    m_Localized: "\u0639\u062F\u062A \u0645\u0628\u0643\u0631\u064B\u0627 \u0628\u0648\u0631\u062F
      \u0645\u0646 \u0645\u062D\u0637\u0629 \u0627\u0644\u0648\u0642\u0648\u062F.
      \u0627\u0633\u062A\u064F\u0642\u0628\u0644 \u0627\u0644\u0648\u0631\u062F \u0628\u0645\u0627
      \u064A\u0633\u062A\u062D\u0642\u0647\u060C \u0648\u0643\u0627\u0646\u062A \u0627\u0644\u0623\u0645\u0633\u064A\u0629
      \u062C\u0645\u064A\u0644\u0629 \u0645\u0639 \u0630\u0644\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288826
    m_Localized: "\u062A\u0648\u0627\u0632\u0646\u062A \u0627\u0644\u0645\u064A\u0632\u0627\u0646\u064A\u0629.
      \u0648\u0639\u062F\u062A \u0625\u0644\u0649 \u0637\u0628\u0642 \u0641\u064A
      \u0627\u0644\u062B\u0644\u0627\u062C\u0629\u060C \u0645\u063A\u0637\u0649 \u0628\u0639\u0646\u0627\u064A\u0629
      \u0648\u0639\u0644\u064A\u0647 \u0648\u0631\u0642\u0629 \u0645\u0643\u062A\u0648\u0628\u0629
      \u0628\u062E\u0637 \u0623\u0646\u064A\u0642 \u062C\u062F\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288827
    m_Localized: "\u0627\u062A\u0635\u0644 \u0645\u0643\u062A\u0628 \u062A\u0648\u0638\u064A\u0641
      \u0645\u0646 \u062F\u0628\u064A: \u0636\u0639\u0641 \u0627\u0644\u0631\u0627\u062A\u0628\u060C
      \u0648\u0633\u064A\u0627\u0631\u0629\u060C \u0648\u0645\u0643\u062A\u0628 \u0628\u0646\u0627\u0641\u0630\u0629
      \u062A\u064F\u0641\u062A\u062D \u0641\u0639\u0644\u064B\u0627. \u0648\u0644\u0627
      \u064A\u062D\u062A\u0627\u062C\u0648\u0646 \u0625\u0644\u0649 \u062C\u0648\u0627\u0628
      \u0642\u0628\u0644 \u0627\u0644\u063A\u062F."
    m_Metadata:
      m_Items: []
