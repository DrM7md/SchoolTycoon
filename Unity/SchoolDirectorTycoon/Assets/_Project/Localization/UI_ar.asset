      \u0644\u0635\u0627\u062D\u0628 \u0630\u0644\u0643 \u0627\u0644\u0645\u0642\u0637\u0639.
      \u0627\u0644\u0631\u0633\u0645 \u0644\u0644\u0633\u0627\u062D\u0629\u060C \u0648\u0643\u0644
