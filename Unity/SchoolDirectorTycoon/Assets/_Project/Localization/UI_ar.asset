      \u0642\u0628\u0644 \u0623\u0646 \u062A\u0643\u062A\u0645\u0644 \u0627\u0644\u062C\u0645\u0644\u0629:
      \xAB\u0648\u0642\u0641\u0648\u0627 \u0645\u0639\u064A \u0648\u0642\u062A \u0627\u0644\u062D\u0627\u062C\u0629.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288752
    m_Localized: "\u0627\u0644\u0632\u064A\u0627\u062F\u0629 \u0627\u0644\u062A\u064A
