  - m_Id: 517962901094448
    m_Localized: "\u0632\u0627\u062F\u0648\u0627 \u0627\u0644\u0631\u0633\u0648\u0645\u061F\u061F
      \u0632\u0627\u062F \u0627\u0644\u0645\u0633\u062A\u0648\u0649 \u0645\u0639\u0647\u0627
      \u0648\u0644\u0627 \u0628\u0633 \u0627\u0644\u0631\u0633\u0648\u0645"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094449
    m_Localized: "[\u0631\u0633\u0627\u0644\u0629 \u0635\u0648\u062A\u064A\u0629\u060C
      \u0664:\u0661\u0662. \u0623\u063A\u0644\u0628\u0647\u0627 \u0635\u0648\u062A
      \u063A\u0645\u0651\u0627\u0632 \u0627\u0644\u0633\u064A\u0627\u0631\u0629.
      \u0643\u0644\u0645\u0629 \xAB\u0627\u0644\u0631\u0633\u0648\u0645\xBB \u0648\u0631\u062F\u062A
      \u0625\u062D\u062F\u0649 \u0639\u0634\u0631\u0629 \u0645\u0631\u0629.]"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094450
    m_Localized: "\u0628\u0647\u0627\u0644\u0641\u0644\u0648\u0633 \u0623\u0628\u064A
      \u0627\u0644\u0645\u062F\u0631\u0633\u0629 \u062A\u062C\u064A \u0627\u0644\u0628\u064A\u062A
      \u0648\u062A\u062F\u0631\u0651\u0633\u0647\u0645 \u0639\u0646\u062F\u064A"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094451
    m_Localized: "\u0627\u0644\u0644\u0647 \u064A\u0628\u0627\u0631\u0643 \u0641\u064A
      \u0627\u0644\u0645\u062F\u064A\u0631 \u0648\u064A\u0641\u062A\u062D \u0639\u0644\u064A\u0647
      \u0648\u064A\u0634\u0631\u062D \u0635\u062F\u0631\u0647 \u0648\u064A\u0646\u0632\u0651\u0644
      \u0627\u0644\u0631\u0633\u0648\u0645. \u0622\u0645\u064A\u0646"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094452
    m_Localized: "\u0627\u0644\u0633\u0645\u0648\u062D\u0629 \u062A\u0648\u0646\u064A
      \u0623\u0634\u0648\u0641 \u0627\u0644\u0645\u0633\u062C. \u0623\u064A \u0631\u0633\u0648\u0645\u061F
      \u0647\u0630\u064A \u0631\u062D\u0644\u0629 \u0623\u0643\u062A\u0648\u0628\u0631\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094453
    m_Localized: "\u062D\u0633\u0628\u062A\u0647\u0627 \u0648\u0627\u0644\u0644\u0647.
      \u0628\u0646\u0641\u0633 \u0627\u0644\u0645\u0628\u0644\u063A \u0627\u0644\u0639\u064A\u0627\u0644
      \u064A\u062F\u0631\u0633\u0648\u0646 \u0641\u064A \u0633\u0648\u064A\u0633\u0631\u0627
      \u0648\u0645\u0639\u0647\u0645 \u062C\u0628\u0646"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094454
    m_Localized: "\u0623\u062E\u0648\u064A \u064A\u062F\u0641\u0639 \u0623\u0642\u0644
      \u0648\u0645\u062F\u0631\u0633\u062A\u0647\u0645 \u0641\u064A\u0647\u0627 \u0645\u0633\u0628\u062D.
      \u0645\u0627 \u0641\u064A\u0647\u0627 \u0645\u062F\u0631\u0633\u064A\u0646
      \u0628\u0633 \u0641\u064A\u0647\u0627 \u0645\u0633\u0628\u062D"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094455
    m_Localized: "\u0641\u064A\u0647 \u062E\u0635\u0645 \u0644\u0644\u0648\u0644\u062F
      \u0627\u0644\u062B\u0627\u0644\u062B\u061F \u0623\u0633\u0623\u0644 \u0628\u0635\u0641\u062A\u064A
      \u0634\u062E\u0635 \u0639\u0646\u062F\u0647 \u062B\u0644\u0627\u062B\u0629
      \u0639\u064A\u0627\u0644 \u0648\u0645\u0627 \u0639\u0646\u062F\u0647 \u0634\u0639\u0631"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094456
    m_Localized: "\u064A\u0627 \u062C\u0645\u0627\u0639\u0629 \u062E\u0644\u0627\u0635
      \u0644\u0627 \u062A\u062A\u062D\u0644\u0637\u0645\u0648\u0646 \u0647\u0646\u064A.
      \u062A\u062D\u0644\u0637\u0645\u0648\u0627 \u0641\u064A \u0627\u0644\u0642\u0631\u0648\u0628
      \u0627\u0644\u062B\u0627\u0646\u064A\u060C \u0627\u0644\u0644\u064A \u0645\u0627
      \u0641\u064A\u0647 \u0645\u0646\u062F\u0648\u0628\u0629 \u0627\u0644\u0641\u0635\u0644"
    m_Metadata:
      m_Items: []
  - m_Id: 517962901094457
    m_Localized: "\u0627\u0644\u0633\u0645\u0648\u062D\u0629 \u062A\u0648\u0646\u064A
