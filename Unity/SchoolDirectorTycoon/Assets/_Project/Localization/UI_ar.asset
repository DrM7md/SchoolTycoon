      \u0627\u0644\u062F\u0631\u0627\u0633\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288817
    m_Localized: "\u0627\u062A\u0635\u0644\u062A \u0645\u062F\u0631\u0633\u0629 \u0627\u0628\u0646\u0643.
      \u0644\u0645 \u062A\u0641\u062A \u0627\u0644\u0645\u0641\u0627\u0631\u0642\u0629
      \u0645\u0648\u0638\u0641\u0629 \u0627\u0644\u0627\u0633\u062A\u0642\u0628\u0627\u0644.
      \u0627\u0644\u0631\u064A\u0627\u0636\u064A\u0627\u062A \u0644\u0627 \u062A\u0633\u064A\u0631
      \u0639\u0644\u0649 \u0645\u0627 \u064A\u0631\u0627\u0645 \u0645\u0646\u0630
      \u0645\u062F\u0629\u060C \u0648\u064A\u0628\u062F\u0648 \u0623\u0646\u0643
      \u0622\u062E\u0631 \u0645\u0646 \u064A\u0639\u0644\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288818
    m_Localized: "\u0627\u062C\u0644\u0633 \u0648\u0630\u0627\u0643\u0631 \u0645\u0639\u0647"
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288819
    m_Localized: "\u0627\u0633\u062A\u0623\u062C\u0631 \u0645\u062F\u0631\u0633\u064B\u0627
      \u062E\u0635\u0648\u0635\u064A\u064B\u0627"
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288820
    m_Localized: "\u062D\u0644\u0644\u062A\u0645\u0627 \u0627\u0644\u0642\u0633\u0645\u0629
      \u0627\u0644\u0645\u0637\u0648\u0644\u0629 \u0639\u0644\u0649 \u0637\u0627\u0648\u0644\u0629
      \u0627\u0644\u0645\u0637\u0628\u062E \u062D\u062A\u0649 \u0627\u0644\u0639\u0627\u0634\u0631\u0629.
      \u0623\u062E\u0637\u0623\u062A \u0645\u0631\u062A\u064A\u0646\u060C \u0648\u0644\u0645
      \u064A\u0646\u0633 \u0623\u062D\u062F \u0641\u064A \u0627\u0644\u0628\u064A\u062A
      \u0630\u0644\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288821
    m_Localized: "\u0635\u0627\u0631 \u0627\u0644\u0645\u062F\u0631\u0633 \u064A\u0623\u062A\u064A
      \u0643\u0644 \u0627\u062B\u0646\u064A\u0646. \u0623\u0635\u0628\u062D\u062A
      \u0648\u0627\u062D\u062F\u064B\u0627 \u0645\u0646 \u0623\u0648\u0644\u0626\u0643
      \u0627\u0644\u0623\u0647\u0627\u0644\u064A\u060C \u0648\u062A\u0639\u0631\u0641
      \u062A\u0645\u0627\u0645\u064B\u0627 \u0645\u0627\u0630\u0627 \u064A\u064F\u0642\u0627\u0644
      \u0639\u0646\u0647\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288822
    m_Localized: "\u0627\u0644\u064A\u0648\u0645 \u0630\u0643\u0631\u0649 \u0632\u0648\u0627\u062C\u0643.
      \u062A\u0630\u0643\u0631\u062A\u0647\u0627 \u0641\u064A \u0627\u0644\u0631\u0627\u0628\u0639\u0629
      \u0648\u0627\u0644\u0631\u0628\u0639\u060C \u0623\u062B\u0646\u0627\u0621 \u0627\u062C\u062A\u0645\u0627\u0639
      \u0627\u0644\u0645\u064A\u0632\u0627\u0646\u064A\u0629\u060C \u0648\u0635\u062F\u0631
      \u0639\u0646 \u0648\u062C\u0647\u0643 \u0634\u064A\u0621 \u0644\u0627\u062D\u0638\u062A\u0647
      \u0627\u0644\u0645\u062D\u0627\u0633\u0628\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288823
    m_Localized: "\u063A\u0627\u062F\u0631 \u0627\u0644\u0622\u0646 \u0648\u0627\u0634\u062A\u0631\u0650
