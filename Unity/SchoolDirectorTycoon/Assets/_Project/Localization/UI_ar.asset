      \u0645\u0639\u064B\u0627 \u0625\u0644\u0649 \u0628\u0627\u0628\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288744
    m_Localized: "\u062E\u0631\u062C \u062E\u0628\u0631 \u0627\u0644\u062F\u0631\u062C\u0629
      \u0627\u0644\u0645\u0639\u062F\u0644\u0629. \u0644\u0627 \u064A\u0642\u0648\u0644
      \u0644\u0643 \u0627\u0644\u0646\u0627\u0633 \u0634\u064A\u0626\u064B\u0627
      \u0641\u064A \u0648\u062C\u0647\u0643\u060C \u0648\u064A\u062D\u0631\u0635\u0648\u0646
      \u0639\u0644\u0649 \u0630\u0644\u0643 \u062D\u0631\u0635\u064B\u0627 \u0638\u0627\u0647\u0631\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288745
    m_Localized: "\u0645\u0627 \u0633\u062A\u0631\u062A\u0647 \u0643\u0634\u0641
      \u0646\u0641\u0633\u0647 \u0628\u0646\u0641\u0633\u0647. \u0623\u062E\u0628\u0631
      \u0632\u0645\u064A\u0644 \u0642\u0631\u064A\u0628\u064B\u0627 \u0644\u0647\u060C
      \u0648\u0623\u062E\u0628\u0631 \u0627\u0644\u0642\u0631\u064A\u0628 \u063A\u062F\u0627\u0621
      \u0627\u0644\u062C\u0645\u0639\u0629 \u0628\u0623\u0643\u0645\u0644\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288746
    m_Localized: "\u0635\u0627\u0631 \u0627\u0644\u062C\u0645\u064A\u0639 \u064A\u0639\u0631\u0641
