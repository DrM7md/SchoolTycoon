  - m_Id: 517962787848192
    m_Localized: "\u0641\u064A \u063A\u0631\u0641\u0629 \u0627\u0644\u0635\u064A\u0627\u0646\u0629
      \u0635\u0648\u062A \u0644\u0645 \u064A\u0628\u0644\u0651\u063A \u0639\u0646\u0647
      \u0623\u062D\u062F \u0628\u0639\u062F. \u063A\u062F\u064B\u0627 \u0633\u064A\u0628\u0644\u0651\u063A
      \u0623\u062D\u062F\u0647\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900096
    m_Localized: "\u063A\u062F\u064B\u0627 \u0633\u064A\u0643\u0648\u0646 \u0644\u0645\u062C\u0645\u0648\u0639\u0629
      \u0627\u0644\u0623\u0647\u0627\u0644\u064A \u0631\u0623\u064A. \u0644\u0627
      \u0623\u062D\u062F \u064A\u0639\u0631\u0641 \u0641\u064A \u0645\u0627\u0630\u0627\u060C
      \u0648\u0644\u0627 \u0647\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900097
    m_Localized: "\u062A\u0631\u0643 \u0623\u062D\u062F\u0647\u0645 \u0638\u0631\u0641\u064B\u0627
      \u0639\u0646\u062F \u062D\u0627\u0631\u0633 \u0627\u0644\u0628\u0648\u0627\u0628\u0629\u060C
      \u0648\u0642\u062F \u0648\u0639\u062F \u0628\u062A\u0633\u0644\u064A\u0645\u0647
      \u0625\u0644\u064A\u0643 \u0635\u0628\u0627\u062D\u064B\u0627\u060C \u0628\u0639\u062F
      \u0627\u0644\u0634\u0627\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900098
    m_Localized: "\u0635\u0645\u062A\u062A \u063A\u0631\u0641\u0629 \u0627\u0644\u0645\u0639\u0644\u0645\u064A\u0646
      \u062D\u064A\u0646 \u0645\u0631\u0631\u062A \u0628\u0647\u0627 \u0627\u0644\u064A\u0648\u0645.
      \u0627\u0633\u062A\u0645\u062A\u0639 \u0628\u0647\u0630\u0627 \u0627\u0644\u0644\u063A\u0632
      \u062D\u062A\u0649 \u0627\u0644\u0635\u0628\u0627\u062D."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900099
    m_Localized: "\u0635\u0645\u062F\u062A \u0622\u0644\u0629 \u0627\u0644\u062A\u0635\u0648\u064A\u0631
      \u0623\u0633\u0628\u0648\u0639\u064B\u0627 \u0643\u0627\u0645\u0644\u064B\u0627.
      \u0644\u0646 \u064A\u062F\u0648\u0645 \u0647\u0630\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900100
    m_Localized: "\u0637\u0644\u0628 \u0648\u0644\u064A \u0623\u0645\u0631 \xAB\u062E\u0645\u0633
      \u062F\u0642\u0627\u0626\u0642\xBB \u0645\u0646 \u0648\u0642\u062A\u0643 \u063A\u062F\u064B\u0627.
      \u0623\u062E\u0644\u0650 \u0627\u0644\u0635\u0628\u0627\u062D \u0643\u0644\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900101
    m_Localized: "\u0643\u0627\u0646 \u0627\u0644\u0635\u0641 \u0627\u0644\u0633\u0627\u0628\u0639
      \u0645\u0624\u062F\u0628\u064B\u0627 \u0645\u0639 \u0645\u0639\u0644\u0645\u0647
      \u0627\u0644\u064A\u0648\u0645. \u0627\u0639\u0631\u0641 \u0627\u0644\u0633\u0628\u0628
      \u0642\u0628\u0644 \u0623\u0646 \u064A\u062A\u0643\u0631\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900102
    m_Localized: "\u062A\u062C\u0631\u0628 \u0627\u0644\u0645\u0642\u0635\u0641 \u063A\u062F\u064B\u0627
      \u0635\u0646\u0641\u064B\u0627 \u062C\u062F\u064A\u062F\u064B\u0627. \u0644\u0647
      \u0627\u0633\u0645\u060C \u0648\u0644\u0627 \u0623\u062D\u062F \u064A\u0642\u0648\u0644
      \u0645\u0645\u0627 \u0635\u064F\u0646\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900103
    m_Localized: "\u0633\u0623\u0644\u062A\u0643 \u0627\u0644\u0645\u062D\u0627\u0633\u0628\u0629
      \u0625\u0646 \u0643\u0646\u062A \u0633\u062A\u062D\u0636\u0631 \u0645\u0628\u0643\u0631\u064B\u0627.
      \u0633\u0623\u0644\u062A \u0628\u0631\u0641\u0642 \u0634\u062F\u064A\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900104
    m_Localized: "\u062C\u062F\u0648\u0644 \u0627\u0644\u063A\u062F \u064A\u0628\u062F\u0648
      \u0645\u062B\u0627\u0644\u064A\u064B\u0627\u060C \u0648\u0647\u0630\u0647 \u0644\u0645
      \u062A\u0643\u0646 \u0639\u0644\u0627\u0645\u0629 \u062E\u064A\u0631 \u0642\u0637."
    m_Metadata:
      m_Items: []
  - m_Id: 517962896900105
    m_Localized: "\u0633\u0623\u0644 \u0623\u062D\u062F\u0647\u0645 \u0639\u0646
