      m_Items: []
  - m_Id: 517962905288766
    m_Localized: "\u0623\u062E\u0628\u0631\u062A\u0647\u0627. \u0646\u064F\u0634\u0631\u062A
      \u0627\u0644\u0642\u0635\u0629. \u0643\u0627\u0646 \u0623\u0633\u0648\u0623
      \u0623\u0633\u0628\u0648\u0639 \u0641\u064A \u0645\u0633\u064A\u0631\u062A\u0643\u060C
      \u0648\u0646\u0645\u062A \u0641\u064A\u0647 \u0644\u0623\u0648\u0644 \u0645\u0631\u0629
      \u0645\u0646\u0630 \u0634\u0647\u0648\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288767
    m_Localized: "\u0623\u0646\u0643\u0631\u062A \u0628\u0635\u0648\u062A \u062B\u0627\u0628\u062A.
      \u0634\u0643\u0631\u062A\u0643\u060C \u0648\u0642\u0627\u0644\u062A \u0625\u0646\u0647\u0627
      \u062A\u0648\u0642\u0639\u062A \u0630\u0644\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288768
    m_Localized: "\u062A\u0633\u062A\u0637\u064A\u0639 \u0623\u0646 \u062A\u0645\u0631
      \u0628\u0623\u064A \u0648\u0644\u064A \u0623\u0645\u0631 \u0641\u064A \u0623\u064A
      \u0633\u0648\u0642 \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0645\u062F\u064A\u0646\u0629.
      \u064A\u0628\u062F\u0648 \u0647\u0630\u0627 \u0623\u0645\u0631\u064B\u0627
      \u0635\u063A\u064A\u0631\u064B\u0627. \u0627\u0633\u0623\u0644 \u0645\u062F\u064A\u0631\u064B\u0627
      \u0644\u0627 \u064A\u0633\u062A\u0637\u064A\u0639\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288769
    m_Localized: "\u062B\u0645\u0629 \u0645\u0644\u0641\u0627\u062A \u0642\u0644\u064A\u0644\u0629
      \u062A\u0641\u0636\u0651\u0644 \u0623\u0644\u0627 \u062A\u0641\u062A\u062D\u0647\u0627
      \u062B\u0627\u0646\u064A\u0629. \u0644\u0627 \u062A\u0641\u0643\u0631 \u0641\u064A\u0647\u0627
      \u0645\u0639\u0638\u0645 \u0627\u0644\u0644\u064A\u0627\u0644\u064A. \u0645\u0639\u0638\u0645\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288770
    m_Localized: "\u0646\u062C\u062A \u0627\u0644\u0645\u062F\u0631\u0633\u0629\u060C
