      \u0648\u0623\u062B\u0648\u0627\u0628 \u062A\u062E\u0631\u062C \u0623\u0637\u0648\u0644
      \u0642\u0644\u064A\u0644\u064B\u0627 \u0645\u0645\u0627 \u064A\u0646\u0628\u063A\u064A\u060C
      \u0648\u0643\u0644 \u0648\u0644\u064A \u0623\u0645\u0631 \u064A\u0631\u0641\u0639
      \u0647\u0627\u062A\u0641\u0647. \u0627\u0644\u062C\u0645\u064A\u0639 \u064A\u0646\u062A\u0638\u0631
      \u0643\u0644\u0645\u062A\u0643."
    m_Metadata:
      m_Items: []
