      \u0625\u0636\u0627\u0641\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288777
    m_Localized: "\u063A\u0627\u062F\u0631 \u0627\u0644\u0645\u062F\u064A\u0631 \u0627\u0644\u0633\u0627\u0628\u0642
      \u0639\u0644\u0649 \u0639\u062C\u0644 \u0648\u0623\u062E\u0630 \u0645\u0639\u0647
      \u0627\u0644\u0643\u0631\u0627\u0633\u064A \u0627\u0644\u062C\u064A\u062F\u0629.
      \u0648\u0642\u062F \u0639\u0631\u0651\u0641\u0643 \u0645\u062D\u0635\u0644
