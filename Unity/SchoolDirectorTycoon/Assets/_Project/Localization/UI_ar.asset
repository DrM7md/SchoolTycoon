  - m_Id: 358896732078153
    m_Localized: "\u0642\u0644\u062A \u0644\u0647 \u0625\u0646 \u0627\u0644\u0643\u0631\u0633\u064A
      \u0639\u0646\u062F \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0644\u0647
      \u0645\u0627 \u0634\u0627\u0621."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078154
    m_Localized: "\u0628\u062F\u0623\u062A \u062A\u0631\u062A\u064A\u0628 \u062D\u0641\u0644
      \u0648\u062F\u0627\u0639\u0647\u060C \u0648\u0627\u0644\u0637\u0644\u0627\u0628
      \u064A\u0635\u0646\u0639\u0648\u0646 \u0628\u0637\u0627\u0642\u0629 \u0643\u0628\u064A\u0631\u0629
      \u062C\u062F\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078155
    m_Localized: "\u0648\u0631\u0642\u0629 \u0645\u0637\u0648\u064A\u0629 \u0639\u0644\u0649
      \u0645\u0643\u062A\u0628\u0643 \u0628\u062E\u0637 \u0645\u0631\u062A\u0628
      \u062C\u062F\u064B\u0627: \u0634\u0643\u0631\u064B\u0627 \u0639\u0644\u0649
      \u0627\u0644\u0645\u062F\u0631\u0633\u0629. \u0623\u062D\u0628 \u0627\u0644\u0645\u0643\u0627\u0646
      \u0647\u0646\u0627. \u0633\u0627\u0644\u0645."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078156
    m_Localized: "\u064A\u0643\u062A\u0628 \u0642\u0633\u0645 \u0627\u0644\u0631\u064A\u0627\u0636\u064A\u0627\u062A:
      \u0635\u0627\u0631\u062A \u0646\u0648\u0631\u0629 \u062A\u0633\u0627\u0639\u062F
      \u0627\u0644\u0635\u063A\u0627\u0631 \u0641\u064A \u0627\u0644\u0641\u0633\u062D\u0629.
      \u062A\u0642\u0648\u0644 \u0625\u0646\u0647\u0627 \u062A\u0631\u062F \u0634\u064A\u0626\u064B\u0627
      \u0645\u0645\u0627 \u0623\u062E\u0630\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078157
    m_Localized: "\u0627\u0643\u062A\u0645\u0644\u062A \u0627\u0644\u0642\u0627\u0626\u0645\u0629.
      \u0641\u064A \u062F\u0641\u062A\u0631 \u0627\u0644\u0623\u0633\u062A\u0627\u0630
      \u064A\u0648\u0633\u0641 \u0623\u062D\u062F \u0639\u0634\u0631 \u0623\u0644\u0641
      \u0627\u0633\u0645\u060C \u0648\u0642\u062F \u062A\u0631\u0643\u0647 \u0645\u0641\u062A\u0648\u062D\u064B\u0627
      \u0639\u0644\u0649 \u0645\u0643\u062A\u0628\u0643 \u0644\u064A\u0648\u0645
      \u0648\u0627\u062D\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078158
    m_Localized: "\u0648\u0642\u0641 \u0633\u0627\u0644\u0645. \u0627\u0631\u062A\u062C\u0641
      \u0635\u0648\u062A\u0647 \u0641\u064A \u0627\u0644\u0633\u0637\u0631 \u0627\u0644\u0623\u0648\u0644\u060C
      \u062B\u0645 \u062A\u0648\u0642\u0641 \u0639\u0646 \u0627\u0644\u0627\u0631\u062A\u062C\u0627\u0641.
      \u0633\u0645\u0639\u0647 \u0645\u0626\u062A\u0627 \u0634\u062E\u0635 \u0644\u0623\u0648\u0644
      \u0645\u0631\u0629\u060C \u0648\u0628\u0643\u062A \u0623\u0645\u0647 \u0641\u064A
      \u0627\u0644\u0635\u0641 \u0627\u0644\u062B\u0627\u0646\u064A."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078159
    m_Localized: "\u0641\u0627\u0632\u062A \u0642\u0635\u064A\u062F\u0629 \u0633\u0627\u0644\u0645
      \u0628\u062C\u0627\u0626\u0632\u0629 \u0627\u0644\u0645\u062F\u064A\u0646\u0629
      \u0628\u0627\u0633\u0645\u0647 \u0647\u0648. \u062C\u0627\u0621 \u0625\u0644\u0649
      \u0645\u0643\u062A\u0628\u0643\u060C \u0648\u0648\u0642\u0641 \u0645\u0633\u062A\u0642\u064A\u0645\u064B\u0627
      \u062C\u062F\u064B\u0627\u060C \u0648\u0642\u0627\u0644 \u0628\u0635\u0648\u062A
      \u0645\u0633\u0645\u0648\u0639: \u0634\u0643\u0631\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078160
    m_Localized: "\u062A\u0623\u0647\u0644\u062A \u0646\u0648\u0631\u0629 \u0625\u0644\u0649
      \u0627\u0644\u0623\u0648\u0644\u0645\u0628\u064A\u0627\u062F \u0627\u0644\u0648\u0637\u0646\u064A.
      \u0648\u0643\u062A\u0628\u062A \u0641\u064A \u0627\u0644\u0627\u0633\u062A\u0645\u0627\u0631\u0629
      \u062A\u062D\u062A \u0633\u0624\u0627\u0644 \u0645\u0646 \u0633\u0627\u0639\u062F\u0643
      \u0623\u0643\u062B\u0631: \u0634\u062E\u0635 \u0641\u064A \u0645\u062F\u0631\u0633\u062A\u064A\u060C
      \u0644\u0645 \u0623\u0639\u0631\u0641 \u0645\u0646 \u0647\u0648."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078161
    m_Localized: "\u0633\u062F\u062F\u062A \u0639\u0627\u0626\u0644\u0629 \u0646\u0648\u0631\u0629
      \u0622\u062E\u0631 \u0642\u0633\u0637\u060C \u0646\u0642\u0648\u062F\u064B\u0627
      \u0648\u0631\u0642\u064A\u0629 \u0648\u0645\u0639\u062F\u0646\u064A\u0629.
      \u0637\u0644\u0628\u062A \u0627\u0644\u0625\u064A\u0635\u0627\u0644 \u0628\u0646\u0641\u0633\u0647\u0627
      \u0648\u0627\u062D\u062A\u0641\u0638\u062A \u0628\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078162
    m_Localized: "\u0623\u0639\u0637\u0649 \u0627\u0644\u0623\u0633\u062A\u0627\u0630
      \u064A\u0648\u0633\u0641 \u062F\u0631\u0633\u0647 \u0627\u0644\u0623\u062E\u064A\u0631
      \u0627\u0644\u064A\u0648\u0645 \u062C\u0627\u0644\u0633\u064B\u0627\u060C \u0648\u0627\u0644\u0628\u0627\u0628
      \u0645\u0641\u062A\u0648\u062D \u0644\u064A\u0633\u0645\u0639\u0647 \u0627\u0644\u0645\u0645\u0631.
      \u0644\u0645 \u064A\u0645\u0631 \u0623\u062D\u062F \u062F\u0648\u0646 \u0623\u0646
      \u064A\u062A\u0648\u0642\u0641."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078163
    m_Localized: "\u062D\u0636\u0631 \u062D\u0641\u0644 \u0648\u062F\u0627\u0639
      \u0627\u0644\u0623\u0633\u062A\u0627\u0630 \u064A\u0648\u0633\u0641 \u0623\u0631\u0628\u0639\u0629
      \u0623\u062C\u064A\u0627\u0644 \u0645\u0646 \u0639\u0627\u0626\u0644\u0629
      \u0648\u0627\u062D\u062F\u0629\u060C \u0648\u062D\u064A\u0651\u0627 \u0643\u0644
      \u0648\u0627\u062D\u062F \u0645\u0646\u0647\u0645 \u0628\u0627\u0633\u0645\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078164
    m_Localized: "\u062A\u0631\u0643 \u0637\u0641\u0644 \u0628\u0631\u062A\u0642\u0627\u0644\u0629
      \u0639\u0644\u0649 \u0645\u0643\u062A\u0628\u0643 \u062F\u0648\u0646 \u0648\u0631\u0642\u0629.
      \u0643\u0627\u0646\u062A \u0628\u0631\u062A\u0642\u0627\u0644\u0629 \u0645\u0645\u062A\u0627\u0632\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078165
    m_Localized: "\u064A\u0642\u0648\u0644 \u0639\u0627\u0645\u0644 \u0627\u0644\u0646\u0638\u0627\u0641\u0629
      \u0625\u0646 \u0631\u0627\u0626\u062D\u0629 \u0627\u0644\u0645\u062F\u0631\u0633\u0629
      \u0623\u0641\u0636\u0644 \u0645\u0646 \u0642\u0628\u0644\u060C \u0648\u0642\u062F
      \u0642\u0631\u0631\u062A \u0627\u0639\u062A\u0628\u0627\u0631 \u0647\u0630\u0627
      \u0645\u062F\u064A\u062D\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078166
    m_Localized: "\u0637\u0641\u0644 \u0641\u064A \u0627\u0644\u0635\u0641 \u0627\u0644\u062B\u0627\u0646\u064A
      \u064A\u0631\u064A\u062F \u0623\u0646 \u064A\u0635\u0628\u062D \u0645\u062F\u064A\u0631\u064B\u0627
      \u062D\u064A\u0646 \u064A\u0643\u0628\u0631\u060C \u0648\u064A\u0633\u0623\u0644
      \u0645\u0627\u0630\u0627 \u062A\u0639\u0645\u0644 \u0628\u0627\u0644\u0636\u0628\u0637."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078167
    m_Localized: "\u0648\u0642\u0641 \u0637\u0627\u0644\u0628 \u0633\u0627\u0628\u0642
      \u0639\u0646\u062F \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0647\u0630\u0627
      \u0627\u0644\u0635\u0628\u0627\u062D \u0644\u064A\u0646\u0638\u0631 \u0641\u0642\u0637\u060C
      \u0648\u0644\u0648\u0651\u062D \u0644\u0627 \u0644\u0623\u062D\u062F \u0628\u0639\u064A\u0646\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078168
    m_Localized: "\u0623\u0632\u0647\u0631\u062A \u0634\u062C\u0631\u0629 \u0627\u0644\u0646\u064A\u0645
      \u0639\u0646\u062F \u0627\u0644\u0628\u0648\u0627\u0628\u0629\u060C \u0648\u0623\u062E\u0628\u0631\u0643
      \u062B\u0644\u0627\u062B\u0629 \u0645\u0639\u0644\u0645\u064A\u0646 \u0628\u0630\u0644\u0643
      \u0643\u0644 \u0639\u0644\u0649 \u062D\u062F\u0629 \u0643\u0623\u0646\u0647
      \u062E\u0628\u0631 \u0639\u0627\u062C\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078169
    m_Localized: "\u0627\u0644\u0645\u0627\u0644 \u0644\u0627 \u064A\u0643\u0641\u064A
      \u0644\u0647\u0630\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078170
    m_Localized: "\u0647\u0630\u0647 \u0627\u0644\u062E\u0637\u0629 \u063A\u064A\u0631
      \u0635\u0627\u0644\u062D\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078171
    m_Localized: "\u0644\u0627 \u064A\u0645\u0643\u0646 \u0641\u0639\u0644 \u0647\u0630\u0627
      \u0627\u0644\u0622\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 358896732078172
    m_Localized: "\u0647\u0630\u0627 \u0627\u0644\u0646\u0634\u0627\u0637 \u063A\u064A\u0631
      \u0645\u062A\u0627\u062D \u0627\u0644\u0644\u064A\u0644\u0629."
