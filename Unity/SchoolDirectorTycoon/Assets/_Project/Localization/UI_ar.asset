    m_Metadata:
      m_Items:
      - rid: 16764451149840384
  - m_Id: 517962905288739
    m_Localized: "\u0648\u0635\u0644 \u0638\u0631\u0641 \u0628\u0644\u0627 \u0627\u0633\u0645\u060C
      \u0641\u064A\u0647 \u0643\u0644 \u0631\u064A\u0627\u0644 \u0645\u0646 \u062F\u064A\u0646
      \u0623\u0639\u0641\u064A\u062A \u0645\u0646\u0647 \u0623\u0633\u0631\u0629
      \u0641\u064A \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0645\u0627\u0636\u064A\u060C
      \u0648\u0645\u0639\u0647 \u0648\u0631\u0642\u0629: \xAB\u062A\u0623\u062E\u0631\u0646\u0627.
      \u0634\u0643\u0631\u064B\u0627 \u0644\u0623\u0646\u0643 \u0644\u0645 \u062A\u0633\u0623\u0644.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288740
    m_Localized: "\u0639\u0627\u062F \u0627\u0644\u062F\u064A\u0646 \u0648\u062D\u062F\u0647.
      \u0642\u0631\u0623\u062A \u0627\u0644\u0648\u0631\u0642\u0629 \u0645\u0631\u062A\u064A\u0646\u060C
      \u0648\u0648\u0636\u0639\u062A\u0647\u0627 \u0641\u064A \u0645\u0643\u0627\u0646
      \u0644\u0627 \u062A\u0630\u0647\u0628 \u0625\u0644\u064A\u0647 \u0627\u0644\u0641\u0648\u0627\u062A\u064A\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288741
    m_Localized: "\u062A\u062D\u062F\u062B\u062A \u0627\u0644\u0623\u0633\u0631\u0629
      \u0627\u0644\u062A\u064A \u0623\u0641\u0633\u062D\u062A \u0644\u0647\u0627
      \u0645\u0643\u0627\u0646\u064B\u0627. \u0648\u0627\u062A\u0635\u0644\u062A
      \u0627\u0644\u064A\u0648\u0645 \u0623\u0633\u0631\u062A\u0627\u0646 \u0623\u062E\u0631\u064A\u0627\u0646
      \u062A\u0633\u0623\u0644\u0627\u0646 \u0639\u0646 \u0635\u062D\u0629 \u0645\u0627
      \u0633\u0645\u0639\u062A\u0627 \u0639\u0646 \u0645\u062F\u0631\u0633\u062A\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288742
    m_Localized: "\u0643\u0627\u0646 \u0645\u0627 \u0633\u0645\u0639\u062A\u0627\u0647
      \u0635\u062D\u064A\u062D\u064B\u0627. \u0648\u0642\u0644\u062A \u0630\u0644\u0643\u060C
      \u0648\u0627\u0632\u062F\u062D\u0645 \u0627\u0644\u0645\u0646\u062D\u062F\u0631
      \u0639\u0646\u062F \u0627\u0644\u0628\u0627\u0628 \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639
      \u0643\u0645\u0627 \u0644\u0645 \u064A\u0632\u062F\u062D\u0645 \u0645\u0646
      \u0642\u0628\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288743
    m_Localized: "\u0642\u0627\u0631\u0646 \u0623\u062D\u062F \u0627\u0644\u0645\u0639\u0644\u0645\u064A\u0646
      \u062F\u0641\u062A\u0631 \u0627\u0644\u062F\u0631\u062C\u0627\u062A \u0628\u0627\u0644\u0634\u0647\u0627\u062F\u0629\u060C
      \u0641\u0627\u062E\u062A\u0644\u0641 \u0627\u0644\u0645\u0633\u062A\u0646\u062F\u0627\u0646\u060C
