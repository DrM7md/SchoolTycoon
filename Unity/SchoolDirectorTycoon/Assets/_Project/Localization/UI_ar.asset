      \u0641\u064A \u0627\u0644\u064A\u0648\u0645 \u0627\u0644\u0645\u0641\u062A\u0648\u062D
      \u0628\u0627\u0644\u0645\u062F\u0631\u0633\u0629 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0629\u060C
