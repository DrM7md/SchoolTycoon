      \u0627\u0642\u062A\u0631\u0636\u062A \u0641\u064A\u0647 \u0644\u062A\u062F\u0641\u0639
      \u0627\u0644\u0631\u0648\u0627\u062A\u0628 \u0641\u064A \u0645\u0648\u0639\u062F\u0647\u0627.
      \u0644\u0645 \u064A\u0646\u0633 \u0623\u062D\u062F \u0645\u0646 \u0641\u0639\u0644
      \u0630\u0644\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288758
    m_Localized: "\u062D\u064A\u0646 \u0648\u0635\u0644\u062A \u0635\u0628\u0627\u062D\u064B\u0627
      \u0648\u062C\u062F\u062A \u0645\u0646 \u0623\u0639\u062F\u0651 \u0644\u0643
      \u0627\u0644\u0634\u0627\u064A. \u0643\u0627\u0646 \u0633\u064A\u0626\u064B\u0627
      \u062C\u062F\u064B\u0627\u060C \u0648\u0634\u0631\u0628\u062A\u0647 \u0643\u0644\u0647."
