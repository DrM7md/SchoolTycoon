  - m_Id: 517962905288795
    m_Localized: "\u064A\u0648\u0645 \u0627\u0644\u0646\u062A\u0627\u0626\u062C.
      \u0645\u062D\u062A\u0631\u0645\u0629. \u0644\u0627 \u0634\u064A\u0621 \u064A\u064F\u062E\u0641\u0649
      \u0648\u0644\u0627 \u0634\u064A\u0621 \u064A\u064F\u0639\u0644\u0651\u0642\u060C
      \u0625\u0644\u0627 \u0625\u0630\u0627 \u062A\u0643\u0631\u0645\u062A \u0628\u0639\u0636
      \u0627\u0644\u062F\u0631\u062C\u0627\u062A \u0628\u0631\u0641\u0639 \u0646\u0641\u0633\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288796
    m_Localized: "\u064A\u0648\u0645 \u0627\u0644\u0646\u062A\u0627\u0626\u062C.
