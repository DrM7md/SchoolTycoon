      \u0627\u0644\u0634\u064A\u0621\u060C \u062B\u0645 \u0648\u0642\u0651\u0639."
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821734
    m_Localized: "\u0643\u0627\u0646\u062A \u0627\u0644\u0633\u062C\u0644\u0627\u062A
      \u0645\u0631\u062A\u0628\u0629\u060C \u0648\u0644\u0645 \u062A\u0643\u0646
      \u0627\u0644\u0646\u062A\u0627\u0626\u062C \u0627\u0644\u062A\u064A \u0641\u064A\u0647\u0627
      \u0643\u0630\u0644\u0643. \u0642\u0644\u0651\u0628 \u0627\u0644\u0645\u0641\u062A\u0634
      \u0627\u0644\u0635\u0641\u062D\u0627\u062A \u0628\u0628\u0637\u0621."
    m_Metadata:
      m_Items: []
