      m_Items: []
  - m_Id: 517962905288763
    m_Localized: "\u0627\u062A\u0635\u0644\u062A \u0635\u062D\u0641\u064A\u0629.
      \u0644\u062F\u064A\u0647\u0627 \u062A\u0648\u0627\u0631\u064A\u062E \u0648\u0648\u062B\u0627\u0626\u0642
      \u0648\u0635\u0648\u062A \u0647\u0627\u062F\u0626 \u0639\u0644\u0649 \u0646\u062D\u0648
      \u0645\u0642\u0644\u0642\u060C \u0648\u062A\u0648\u062F \u0627\u0644\u062D\u0635\u0648\u0644
      \u0639\u0644\u0649 \u062A\u0639\u0644\u064A\u0642\u0643 \u0647\u0630\u0627
      \u0627\u0644\u0645\u0633\u0627\u0621 \u0639\u0644\u0649 \u0645\u0627 \u064A\u062C\u0631\u064A
      \u0641\u064A \u0645\u062F\u0631\u0633\u062A\u0643."
    m_Metadata:
      m_Items: []
  - m_Id: 517962905288764
    m_Localized: "\u0623\u062E\u0628\u0631\u0647\u0627 \u0628\u0643\u0644 \u0634\u064A\u0621"
