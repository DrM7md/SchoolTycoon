    m_Localized: Start work
    m_Metadata:
      m_Items: []
  - m_Id: 504264904015877
    m_Localized: Training centre
    m_Metadata:
      m_Items: []
  - m_Id: 504264904015878
    m_Localized: Places
    m_Metadata:
      m_Items: []
  - m_Id: 504264904015879
    m_Localized: Send on course
    m_Metadata:
      m_Items: []
  - m_Id: 504264904015880
    m_Localized: Build the training centre first.
    m_Metadata:
      m_Items: []
