    m_Localized: Interviews
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821782
    m_Localized: Tell me about your experience.
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821783
    m_Localized: How do you handle a difficult class?
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821784
    m_Localized: What do you dream of?
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821785
    m_Localized: Hire
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821786
    m_Localized: Send them all home
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821787
    m_Localized: Seems inexperienced
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821788
    m_Localized: Seems capable
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821789
    m_Localized: Seems excellent
    m_Metadata:
      m_Items: []
  - m_Id: 504264899821790
