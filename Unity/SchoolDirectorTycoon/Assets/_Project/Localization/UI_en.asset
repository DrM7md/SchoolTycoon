    m_Metadata:
      m_Items: []
  - m_Id: 504264904015874
    m_Localized: Under construction
    m_Metadata:
      m_Items: []
  - m_Id: 504264904015875
    m_Localized: Built
    m_Metadata:
      m_Items: []
