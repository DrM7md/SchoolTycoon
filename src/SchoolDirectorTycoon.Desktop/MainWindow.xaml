<Window x:Class="SchoolDirectorTycoon.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SchoolDirectorTycoon.Desktop"
        Title="School Director Tycoon" Width="1280" Height="920" MinWidth="720" MinHeight="540"
        FlowDirection="RightToLeft" Language="ar" FontFamily="Segoe UI" FontSize="15"
        Background="#0C2020" Foreground="#F4EFDF">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#10243B"/>
            <Setter Property="Background" Value="#E8DEC4"/>
            <Setter Property="BorderBrush" Value="#647D6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5D792"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#CC713E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#183431"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Background="#0C2020">
            <TextBlock Text="SCHOOL DIRECTOR TYCOON  /  03" FontSize="11" Foreground="#F1D58F" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Title}" FontSize="29" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Goal}"
                       Foreground="#CBD5E1" Margin="0,2,0,8"/>
            <WrapPanel>
                <Button Content="{DynamicResource New}" Click="NewGame"/>
                <Button Content="{DynamicResource Save}" Click="SaveManual"/>
                <Button Content="{DynamicResource Load}" Click="LoadManual"/>
                <Button Content="{DynamicResource Auto}" Click="LoadAuto"/>
                <ComboBox x:Name="LanguageChoice" Width="116" Height="34" VerticalAlignment="Top"
                          AutomationProperties.Name="اللغة / Language" SelectionChanged="ChangeLanguage">
                    <ComboBoxItem Content="العربية"/><ComboBoxItem Content="English"/>
                </ComboBox>
            </WrapPanel>
            <TextBlock x:Name="Status" Foreground="#FCD34D" MinHeight="21" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="Dashboard" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OutcomeText" Foreground="#99F6E4" Margin="0,6,0,10"/>
                        <WrapPanel>
                            <Button x:Name="NextDay" Content="{DynamicResource Next}" Background="#99F6E4" Click="Advance"/>
                            <TextBlock Text="{DynamicResource SpeedLabel}" Margin="0,8,8,0"/>
                            <ComboBox x:Name="Speed" Width="105" Height="33" VerticalAlignment="Top"
                                      AutomationProperties.Name="{DynamicResource SpeedLabel}" SelectionChanged="SpeedChanged">
                                <ComboBoxItem Content="{DynamicResource Pause}"/><ComboBoxItem Content="×1"/><ComboBoxItem Content="×2"/>
                                <ComboBoxItem Content="×4"/><ComboBoxItem Content="×8"/><ComboBoxItem Content="×16"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" BorderBrush="#55796A" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="+" Click="ZoomIn" AutomationProperties.Name="{DynamicResource ZoomIn}"/>
                                <Button Content="−" Click="ZoomOut" AutomationProperties.Name="{DynamicResource ZoomOut}"/>
                                <Button Content="{DynamicResource ResetCamera}" Click="ResetCamera"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource CampusHeading}" Style="{StaticResource Heading}" Foreground="#F1D58F"/>
                        </DockPanel>
                        <WrapPanel x:Name="FacilityButtons"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="CancelBuildButton" DockPanel.Dock="Right" Click="CancelBuild"
                                    Content="{DynamicResource CancelBuild}" Visibility="Collapsed"/>
                            <TextBlock x:Name="MapHint" Foreground="#D5E1D2" MinHeight="28"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                        <local:CampusMap x:Name="World" Height="395" FlowDirection="LeftToRight"
                                         PreviewKeyDown="MapKeyDown"
                                         AutomationProperties.Name="{DynamicResource CampusHeading}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="PlanningTip" Foreground="#CBD5E1" Margin="0,2,0,8"/>
                        <Expander x:Name="StarterGuide" Header="{DynamicResource StarterGuide}"
                                  Foreground="#F1F5F9" Margin="0,3,0,0">
                            <StackPanel Margin="0,8,0,2">
                                <TextBlock Text="{DynamicResource GuideCapacity}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource GuideStaff}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource GuideTuition}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource GuideDay}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource GuideReport}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border x:Name="IncidentCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Decision}"/>
                        <TextBlock x:Name="IncidentText" Margin="0,0,0,9"/>
                        <WrapPanel>
                            <Button x:Name="InterveneButton" Click="Intervene"/>
                            <Button Content="{DynamicResource Ignore}" Click="IgnoreIncident"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="Management">
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Manage}"/>
                        <TextBlock x:Name="CampusSummary" Margin="0,0,0,7"/>
                        <TextBlock x:Name="StaffSummary" Margin="0,6,0,7"/>
                        <WrapPanel x:Name="StaffButtons"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Tuition}" Margin="0,8,10,0"/>
                            <TextBox x:Name="TuitionInput" Width="60" Height="31" VerticalAlignment="Top"
                                     AutomationProperties.Name="{DynamicResource Tuition}" FlowDirection="LeftToRight" MaxLength="2" KeyDown="TuitionKeyDown"/>
                            <Button Content="{DynamicResource Apply}" Margin="8,0,0,0" Click="ApplyTuition"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Finance}"/>
                        <TextBlock x:Name="FinanceSummary" Margin="0,0,0,10"/>
                        <ListBox x:Name="Reports" MaxHeight="220" MinHeight="32" Background="#0F172A" Foreground="#E2E8F0"
                                 AutomationProperties.Name="{DynamicResource ReportsLabel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Padding="4"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
